# ==========================================
# PhishGuard AI - Root .gitignore
# ==========================================

# --- OS & Editor Files ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo

# --- Environment Files & Secrets ---
.env
.env.*
.env.local
!.env.example

# --- Backend (Python / FastAPI) ---
backend/__pycache__/
backend/*/__pycache__/
backend/**/__pycache__/
*.py[cod]
*$py.class
backend/venv/
backend/.venv/
backend/env/
venv/
.venv/
env/
backend/.pytest_cache/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Frontend (Node / React / Vite) ---
frontend/node_modules/
node_modules/
frontend/dist/
dist/
frontend/dist-ssr/
frontend/.vite/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# --- General Logs ---
*.log
logs/
